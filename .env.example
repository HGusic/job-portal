# App
PRACTICE_NAME="Kidz and Teen Dental + Orthodontics"
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://admin.localhost:3000"
PUBLIC_APP_URL="http://localhost:3000"
ADMIN_APP_URL="http://admin.localhost:3000"

# Admin seed (used only by prisma/seed.ts)
ADMIN_EMAIL="kidzandteendental@orthodontics"
ADMIN_PASSWORD="kidzandteendental"

# Postgres — local Docker. On AWS, point this at RDS.
DATABASE_URL="postgresql://jobportal:jobportal@localhost:5432/jobportal?schema=public"

# Object storage — MinIO locally; Amazon S3 in production (omit S3_ENDPOINT).
S3_BUCKET="resumes"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_ENDPOINT="http://127.0.0.1:9000"
S3_FORCE_PATH_STYLE="true"
